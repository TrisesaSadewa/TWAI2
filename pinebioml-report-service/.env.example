# PineBioML AI Report Microservice Environment Settings

# API Server Configuration
PORT=8000
HOST=0.0.0.0

# LLM Narrative Generator Settings
# To enable OpenAI narrative analysis, provide your key below:
LLM_API_KEY=your_openai_api_key_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Set WRITER_DEPLOYMENT=cpu on CPU-only Ollama deployments to use Gemma as
# the report writer. Leave as gpu to keep LLM_MODEL, e.g. deepseek-r1:14b.
WRITER_DEPLOYMENT=gpu
CPU_DEPLOYMENT_WRITER_MODEL=qwen3.5:9b
LLM_REQUEST_TIMEOUT_SECONDS=900
ENABLE_VISION_ANALYSIS=false
VISION_ANALYSIS_TIMEOUT_SECONDS=30

# Tier-2 hallucination verifier model (Ollama tag). Reuses warm qwen3.5:9b in VRAM.
VERIFIER_MODEL=qwen3.5:9b

# Storage Configuration
STORAGE_DIR=./storage

# Retention policy — set to 0 to disable automatic deletion for a category.
# Uploaded clinical datasets are deleted N days after training completes.
DATASET_RETENTION_DAYS=7
# Generated reports, media plots, PDFs, and DOCX are deleted N days after creation.
REPORT_RETENTION_DAYS=90

# Security Settings
# A secure randomized string required to authenticate requests to /report/generate
SERVICE_API_KEY=your_secure_random_key_here
# Comma-separated list of allowed origins for CORS (e.g., http://localhost:3000). Use * to allow all.
ALLOWED_ORIGINS=*
ENABLE_API_DOCS=true
PUBLIC_METRICS=false
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.csv,.tsv,.xlsx,.xls
