# Copy this file to .env.production on the NCU server and fill real values.
# Do not commit .env.production.

# API server
PORT=8000
HOST=0.0.0.0
API_PUBLIC_PORT=8001

# Security
SERVICE_API_KEY=replace_with_a_long_random_secret
ALLOWED_ORIGINS=https://pinebioml.ncu.edu.tw
ENABLE_API_DOCS=false
PUBLIC_METRICS=false
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.csv,.tsv,.xlsx,.xls

# Database
POSTGRES_USER=pinebioml
[][][][][][][][][][][][][] POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=pinebioml_db

# Local Ollama deployment
OLLAMA_BASE_URL=http://ollama:11434
LLM_API_BASE_URL=http://ollama:11434/v1
LLM_MODEL=deepseek-r1:14b
WRITER_DEPLOYMENT=gpu
CPU_DEPLOYMENT_WRITER_MODEL=deepseek-r1:14b
VERIFIER_MODEL=qwen2.5-coder:14b
EMBEDDING_MODEL=nomic-embed-text
VISION_MODEL=glm-ocr:latest
ENABLE_VISION_ANALYSIS=false
VISION_ANALYSIS_TIMEOUT_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=900

# App storage inside the container. The prod compose maps this to a named volume.
STORAGE_DIR=/app/storage
MEDIA_ROOT=/app/storage/media
